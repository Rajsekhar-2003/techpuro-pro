[Unit]
Description=TechPuro (Gunicorn)
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/techpuro
EnvironmentFile=/var/www/techpuro/.env
ExecStart=/var/www/techpuro/venv/bin/gunicorn --workers 2 --bind 127.0.0.1:8000 wsgi:app
Restart=always

[Install]
WantedBy=multi-user.target
